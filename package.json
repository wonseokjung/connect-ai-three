{
  "name": "connect-ai-three",
  "version": "0.6.0",
  "description": "The AI Web 3D Agent (AI Web 3D automation agent) of CONNECT AI LAB: one sentence becomes a finished three.js video, 16:9 and 9:16, frame-exact H.264 BT.709. It starts from the best base it can find: 28 working examples (13 from the official three.js examples, 12 viral community works from X with cleared licences, 3 written from prompts their authors shared), a library of 74 licence-checked community works plus 10 shared prompts, or a fresh find on GitHub, X or Threads (scout: find, fetch), and credits it. Plus one scene spec that becomes a web page and a video with a self-check. Open source by CONNECT AI LAB.",
  "type": "module",
  "license": "MIT",
  "author": "CONNECT AI LAB",
  "bin": {
    "connect-ai-three": "bin/cli.mjs"
  },
  "scripts": {
    "test": "node tests/run.mjs",
    "demo": "node bin/cli.mjs demo",
    "check": "node bin/cli.mjs check",
    "catalog": "node bin/cli.mjs catalog",
    "typecheck": "tsc -p .",
    "find": "node bin/cli.mjs find"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@react-three/fiber": "9.3.0",
    "@remotion/bundler": "4.0.529",
    "@remotion/cli": "4.0.529",
    "@remotion/renderer": "4.0.529",
    "@remotion/three": "4.0.529",
    "esbuild": "0.28.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.529",
    "three": "0.170.0",
    "three-mesh-bvh": "0.9.18",
    "three-latest": "npm:three@0.187.0"
  },
  "devDependencies": {
    "@types/react": "19.1.0",
    "@types/three": "0.170.0",
    "typescript": "5.6.3"
  },
  "files": [
    "bin/",
    "lib/",
    "src/",
    "catalog/",
    "examples/",
    "!examples/**/preview.jpg",
    "!examples/**/preview.mp4",
    "!examples/**/preview.webp",
    "!examples/**/preview-9x16.mp4",
    "!examples/scene-json/*/assets/**",
    "assets/",
    "skill/",
    "licenses/",
    "tests/",
    "remotion.config.ts",
    "tsconfig.json",
    "CHANGELOG.md",
    "NOTICE.md",
    "README.md",
    "README.ko.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wonseokjung/connect-ai-three.git"
  },
  "homepage": "https://github.com/wonseokjung/connect-ai-three#readme",
  "keywords": [
    "three",
    "threejs",
    "webgl",
    "3d",
    "remotion",
    "react-three-fiber",
    "scene-spec",
    "motion-graphics",
    "visual-vibe-coding",
    "claude-code",
    "skill",
    "ai-agent",
    "automation-agent",
    "community",
    "scout",
    "video"
  ]
}
